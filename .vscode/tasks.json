{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Work Agent: Entwicklung starten",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev.ps1",
        "up"
      ],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Work Agent: Entwicklung stoppen",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev.ps1",
        "down"
      ],
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Work Agent: Python neu starten",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev.ps1",
        "restart",
        "-NoBrowser"
      ],
      "problemMatcher": []
    }
  ]
}
